SYSTEM_WS_URL=ws://127.0.0.1:3000/ws/hardware
HARDWARE_TOKEN=change-this-hardware-token
SENSOR_PORT=/dev/serial0
SENSOR_BAUD=57600
RELAY_PIN=17
RELAY_ACTIVE_HIGH=1
RELAY_DURATION_MS=3000
# UART: timeout baca lebih pendek + auto-reset jika macet (detik)
SERIAL_READ_TIMEOUT_S=0.3
UART_IO_STUCK_S=10
UART_ERROR_FLUSH_THRESHOLD=1
UART_ERROR_RESET_THRESHOLD=12
UART_RESYNC_EVERY=4
VERIFY_POLL_INTERVAL_S=0.25
VERIFY_IMAGE_TIMEOUT_S=0.5
POST_SCAN_AFTER_RELAY_S=1.0
UART_READIMAGE_LOG_INTERVAL_S=30
SIMULATE=1
