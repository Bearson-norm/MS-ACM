generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserSystem {
  uid       String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("user_system")
}

model UserMachine {
  uid           String   @id @default(uuid())
  username      String   @unique
  password      String
  fingerprintId Int      @unique @map("fingerprint_id")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("user_machine")
}

model LogsTransaction {
  uid       String   @id @default(uuid())
  username  String
  timestamp DateTime @default(now())
  status    String
  sensor    String

  @@index([timestamp])
  @@index([status])
  @@map("logs_transaction")
}
